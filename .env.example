# ——— Основное ———
PORT=3000
NODE_ENV=production
# Длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
# Публичный адрес приложения (для ссылок в Discord)
PUBLIC_URL=https://control.cyberhub.lv
# Где хранить базу и фото (по умолчанию server/data)
# DATA_DIR=/var/lib/cyberhub

# ——— Брони с Tilda ———
# Секрет, который знают только Tilda/ретранслятор и приложение: openssl rand -hex 16
TILDA_TOKEN=

# ——— Discord (Настройки канала → Интеграции → Вебхуки) ———
DISCORD_WEBHOOK_BOOKINGS=
DISCORD_WEBHOOK_GENERAL=

# ——— Google Таблица смен (Файл → Поделиться → Опубликовать в интернете → лист → CSV) ———
SHIFTS_CSV_URL=
